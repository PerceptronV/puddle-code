APP_HOST=app.example.com
RELAY_HOST=relay.example.com
PUDDLE_REMOTE_APP=https://app.example.com
PUDDLE_REMOTE_SERVICE=https://relay.example.com
PUDDLE_REMOTE_WSS=wss://relay.example.com
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Configure at least one provider. Both values are required for each enabled provider.
# Register /api/auth/callback/google or /github on the relay origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional release repository for installers; defaults to package repository metadata.
PUDDLE_REPO=
