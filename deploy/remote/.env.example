APP_HOST=app.example.com
RELAY_HOST=relay.example.com
TLS_EMAIL=operator@example.com
PUDDLE_REMOTE_APP=https://app.example.com
PUDDLE_REMOTE_SERVICE=https://relay.example.com
PUDDLE_REMOTE_WSS=wss://relay.example.com
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PUDDLE_SMTP_URL=smtps://username:password@mail.example.com:465
PUDDLE_EMAIL_FROM=puddle@example.com
PUDDLE_SIGNUP_EMAILS=owner@example.com
PUDDLE_OPEN_SIGNUP=false
# Optional. Register /api/auth/callback/google or /github on the relay origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
