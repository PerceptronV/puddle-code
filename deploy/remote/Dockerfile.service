FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ ca-certificates && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /build
COPY . .
RUN pnpm install --frozen-lockfile --filter @puddle/remote...
RUN pnpm --filter @puddle/shared build && pnpm --filter @puddle/remote build

FROM node:22-bookworm-slim
RUN groupadd --gid 10001 puddle && useradd --uid 10001 --gid puddle --no-create-home puddle && mkdir /data && chown puddle:puddle /data
WORKDIR /app
COPY --from=build /build/node_modules ./node_modules
COPY --from=build /build/packages/remote/node_modules ./packages/remote/node_modules
COPY --from=build /build/packages/remote/package.json ./packages/remote/package.json
COPY --from=build /build/packages/remote/dist ./packages/remote/dist
COPY --from=build /build/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=build /build/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /build/packages/shared/dist ./packages/shared/dist
USER 10001:10001
WORKDIR /app/packages/remote
# Fail the image build if workspace links or the native SQLite binding are missing.
RUN node --input-type=module -e "await import('./dist/server.js'); const { default: Database } = await import('better-sqlite3'); new Database(':memory:').close()"
ENV NODE_ENV=production HOST=0.0.0.0 PORT=7440 PUDDLE_REMOTE_HOME=/data
EXPOSE 7440
CMD ["node", "dist/index.js"]
